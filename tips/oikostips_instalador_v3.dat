@echo off
REM ================================================================
REM  HATTORI - TIPS DE CIBERSEGURIDAD - INSTALADOR (InvGate, como SYSTEM)
REM  - Copia el programa a C:\ProgramData\Oikos\Tips (zip embebido).
REM  - Crea la tarea Oikos\Hattori: todos los dias a las 11:30,
REM    en la sesion del usuario conectado. No muestra nada al instalar.
REM  Codigos: 0=instalado | 3=error | 4=falta .NET 4.6.2 o WebView2
REM  Paquete InvGate: CODIGO DE EXITO = 0.
REM  Prueba sin instalar: Tips_hattori_instalar.bat --extraer CARPETA
REM ================================================================
setlocal
set "ARCHIVO_BAT=%~f0"
set "CARPETA=C:\ProgramData\Oikos"
set "DESTINO=%CARPETA%\Tips"
set "XML=%CARPETA%\tips_hattori_tarea.xml"
set "LOG=%CARPETA%\tips_hattori_instalar.log"

if /I "%~1"=="--extraer" (
  set "DESTINO=%~2"
  goto extraer
)

if not exist "%CARPETA%" mkdir "%CARPETA%"
>>"%LOG%" echo %DATE% %TIME% Inicio en %COMPUTERNAME%

REM --- 1) Requisitos: .NET 4.6.2+ y WebView2 ---
powershell -NoProfile -ExecutionPolicy Bypass -Command "$r=(Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full' -ErrorAction SilentlyContinue).Release; $k='Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}'; $w=(Get-ItemProperty \"HKLM:\SOFTWARE\WOW6432Node\$k\",\"HKLM:\SOFTWARE\$k\" -ErrorAction SilentlyContinue | Where-Object { $_.pv -and $_.pv -ne '0.0.0.0' }); if ($r -ge 394802 -and $w) { exit 0 } else { exit 4 }"
if errorlevel 1 (
  >>"%LOG%" echo Falta .NET 4.6.2 o WebView2
  exit /b 4
)

taskkill /IM OikosTips.exe /F >nul 2>&1

:extraer
REM --- 2) Extraer el programa embebido al final de este archivo ---
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $f=$env:ARCHIVO_BAT; $l=[IO.File]::ReadAllLines($f); $i=[array]::IndexOf($l,'::ZIP::'); $b=[Convert]::FromBase64String(($l[($i+1)..($l.Length-1)] -join '')); $z=Join-Path $env:TEMP ('oikos_tips_'+[guid]::NewGuid().ToString('N')+'.zip'); [IO.File]::WriteAllBytes($z,$b); New-Item -ItemType Directory -Force -Path $env:DESTINO | Out-Null; Add-Type -AssemblyName System.IO.Compression.FileSystem; $a=[IO.Compression.ZipFile]::OpenRead($z); foreach($e in $a.Entries){ [IO.Compression.ZipFileExtensions]::ExtractToFile($e,(Join-Path $env:DESTINO $e.Name),$true) }; $a.Dispose(); Remove-Item $z -Force"
if errorlevel 1 (
  if /I not "%~1"=="--extraer" >>"%LOG%" echo Error al extraer
  exit /b 3
)
if /I "%~1"=="--extraer" exit /b 0
if not exist "%DESTINO%\OikosTips.exe" (
  >>"%LOG%" echo Falta OikosTips.exe tras extraer ^(Kaspersky?^)
  exit /b 3
)

REM --- 3) Tarea programada en la sesion del usuario ---
> "%XML%" echo ^<?xml version="1.0"?^>
>>"%XML%" echo ^<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task"^>
>>"%XML%" echo   ^<RegistrationInfo^>^<Description^>Hattori - tips de ciberseguridad - Direccion de TI Oikos^</Description^>^</RegistrationInfo^>
>>"%XML%" echo   ^<Triggers^>
>>"%XML%" echo     ^<CalendarTrigger^>^<StartBoundary^>2026-01-01T11:30:00^</StartBoundary^>^<Enabled^>true^</Enabled^>^<ScheduleByDay^>^<DaysInterval^>1^</DaysInterval^>^</ScheduleByDay^>^</CalendarTrigger^>
>>"%XML%" echo   ^</Triggers^>
>>"%XML%" echo   ^<Principals^>^<Principal id="Author"^>^<GroupId^>S-1-5-32-545^</GroupId^>^<RunLevel^>LeastPrivilege^</RunLevel^>^</Principal^>^</Principals^>
>>"%XML%" echo   ^<Settings^>
>>"%XML%" echo     ^<MultipleInstancesPolicy^>IgnoreNew^</MultipleInstancesPolicy^>
>>"%XML%" echo     ^<DisallowStartIfOnBatteries^>false^</DisallowStartIfOnBatteries^>
>>"%XML%" echo     ^<StopIfGoingOnBatteries^>false^</StopIfGoingOnBatteries^>
>>"%XML%" echo     ^<StartWhenAvailable^>false^</StartWhenAvailable^>
>>"%XML%" echo     ^<Enabled^>true^</Enabled^>
>>"%XML%" echo     ^<ExecutionTimeLimit^>PT2H^</ExecutionTimeLimit^>
>>"%XML%" echo   ^</Settings^>
>>"%XML%" echo   ^<Actions Context="Author"^>^<Exec^>^<Command^>%DESTINO%\OikosTips.exe^</Command^>^<WorkingDirectory^>%DESTINO%^</WorkingDirectory^>^</Exec^>^</Actions^>
>>"%XML%" echo ^</Task^>

schtasks /Create /TN "Oikos\Hattori" /XML "%XML%" /F >nul 2>&1
if errorlevel 1 (
  >>"%LOG%" echo Error al crear la tarea
  exit /b 3
)
schtasks /Query /TN "Oikos\Hattori" >nul 2>&1
if errorlevel 1 exit /b 3
>>"%LOG%" echo Instalado OK
exit /b 0

